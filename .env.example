# --- Database (any MySQL-compatible host, e.g. TiDB Cloud Serverless free tier) ---
DATABASE_URL="mysql://user:password@host:4000/mass_ai?ssl={\"rejectUnauthorized\":true}"

# --- AI (Google AI Studio -> aistudio.google.com -> Get API key) ---
GEMINI_API_KEY="AIza..."
# Optional: override if the model below is ever retired. Check
# ai.google.dev/gemini-api/docs/models for current model ids.
GEMINI_MODEL="gemini-3.5-flash"

# --- Firebase Admin (server) — Firebase console -> Project settings ---
# -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Firebase Client (browser) — Firebase console -> Project settings -> General
# -> Your apps -> Web app -> SDK setup and configuration ---
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""

# --- Misc ---
JWT_SECRET="any-random-string"
NODE_ENV="production"
